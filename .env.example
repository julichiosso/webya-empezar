# WebYa /empezar — variables de entorno.
# Copiá este archivo a .env.local y completá. NUNCA subas .env.local al repo.
# Las que empiezan con NEXT_PUBLIC_ son visibles en el navegador: no pongas secretos ahí.

# --- Sitio ---------------------------------------------------------------
# Dominio canónico, sin barra final. Se usa en canonical, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=https://webya.ar

# --- Contacto (TODO: completar con los datos reales) ----------------------
# WhatsApp del negocio en formato internacional sin "+" ni espacios. Ej: 5491123456789
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Mail de contacto que se muestra en el footer.
NEXT_PUBLIC_CONTACT_EMAIL=
# Perfil de Instagram.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/webya.dev

# --- Persistencia de leads -------------------------------------------------
# Sin definir  -> en desarrollo y tests: memoria; en producción: supabase si hay credenciales.
# "memory"   -> en memoria (por defecto en desarrollo y tests)
# "file"     -> guarda en .data/leads.json (para inspeccionar leads locales)
# "supabase" -> Postgres en Supabase (producción). Requiere las dos variables de abajo.
#               En desarrollo escribe en la base REAL: el arranque falla salvo ALLOW_SUPABASE_IN_DEV=1.
# LEAD_REPOSITORY=

# Ruta del JSON cuando LEAD_REPOSITORY=file (por defecto .data/leads.json).
# LEADS_FILE_PATH=.data/leads.json

# Supabase (solo servidor). La service role key NUNCA debe llevar prefijo NEXT_PUBLIC_.
# En producción, si LEAD_REPOSITORY no está definida y estas dos sí, se usa supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Solo para el test de seguridad contra un proyecto de Supabase de PRUEBA (con la migración
# aplicada). Si faltan, ese test se omite. No uses las claves de producción.
# SUPABASE_TEST_URL=
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_SERVICE_ROLE_KEY=

# --- Anti-spam ---------------------------------------------------------------
# Sal secreta para hashear la IP (no se guarda la IP en claro). Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
# Máximo de envíos por IP en la ventana, y ventana en segundos.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
# Intentos por minuto y por IP (válidos o no), en memoria por instancia. Frena ráfagas de bots.
RATE_LIMIT_BURST_PER_MINUTE=20

# Analítica: no usa variables de entorno. Se conecta registrando un "sink" (ver README, sección Analítica).
