# Webya (webya.dev) — variables de entorno.
# Copiá este archivo a .env.local y completá. NUNCA subas .env.local al repo.
# Las que empiezan con NEXT_PUBLIC_ son visibles en el navegador: no pongas secretos ahí.

# --- Sitio ---------------------------------------------------------------
# El dominio canónico (https://webya.dev) está fijo en src/lib/site-config.ts: canonical, Open Graph,
# sitemap y JSON-LD apuntan siempre ahí, aunque el sitio se sirva desde *.vercel.app.

# --- Contacto -------------------------------------------------------------
# WhatsApp de Julián en formato wa.me (54 + 9 + característica + número). Opcional: si falta, se usa el
# mismo número por defecto de src/lib/site-config.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=5493406419495

# --- Persistencia de leads -------------------------------------------------
# Sin definir  -> en desarrollo y tests: memoria; next start local: archivo; en Vercel: supabase si hay credenciales.
# "memory"   -> en memoria (por defecto en desarrollo y tests)
# "file"     -> guarda en .data/leads.json (para inspeccionar leads locales)
# "supabase" -> Postgres en Supabase (producción). Requiere las dos variables de abajo.
#               Fuera de Vercel escribe en la base REAL: el arranque falla salvo ALLOW_SUPABASE_IN_DEV=1.
# LEAD_REPOSITORY=

# Ruta del JSON cuando LEAD_REPOSITORY=file (por defecto .data/leads.json).
# LEADS_FILE_PATH=.data/leads.json

# Supabase (solo servidor). La service role key NUNCA debe llevar prefijo NEXT_PUBLIC_.
# En producción, si LEAD_REPOSITORY no está definida y estas dos sí, se usa supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Solo para el test de seguridad contra un proyecto de Supabase de PRUEBA (con la migración
# aplicada). Si faltan, ese test se omite. No uses las claves de producción.
# SUPABASE_TEST_URL=
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_SERVICE_ROLE_KEY=

# --- Avisos de leads ----------------------------------------------------------
# Para /api/leads (hoy el configurador manda el pedido directo por WhatsApp y no pasa por acá).
# Sin esto los leads de la API se guardan pero NADIE se entera. Configurá al menos uno (los dos, mejor).
# Telegram, gratis y al instante: creá un bot con @BotFather y escribile; el chat id sale de
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mail por Resend (resend.com). NOTIFY_FROM_EMAIL necesita un dominio verificado; sin él, Resend solo
# deja mandar desde onboarding@resend.dev a tu propia cuenta.
RESEND_API_KEY=
NOTIFY_TO_EMAIL=
NOTIFY_FROM_EMAIL=

# --- Anti-spam ---------------------------------------------------------------
# Sal secreta para hashear la IP (no se guarda la IP en claro). Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
# Máximo de envíos por IP en la ventana, y ventana en segundos.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
# Intentos por minuto y por IP (válidos o no), en memoria por instancia. Frena ráfagas de bots.
RATE_LIMIT_BURST_PER_MINUTE=20

# Analítica: sin variables ni scripts de terceros. Los eventos van a POST /api/eventos (tabla eventos en
# Supabase, sin datos personales). El embudo se lee con: select * from embudo_diario;
